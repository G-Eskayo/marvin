# Personal runtime data (lives in ~/.claude/, not the repo)
manifest.json
chroma/
projects/
# ...but the per-project execution profiles are versioned (CONTEXT.md 'Per-project execution profiles'): the pattern above
# was only meant for ~/.claude/projects. finance-os stays local: it names personal data folders and this repo is public.
!/config/projects/
/config/projects/finance-os.json
history.jsonl
handoffs/
skills/self-improve/.background_review.lock
skills/self-improve/.background_review.log
browser-profile/

# graphify output is machine-local and regenerated by each machine's own
# post-commit hook (`graphify update .`). It used to be tracked, so both
# machines' hooks rewrote the same files differently on every commit: dirty trees,
# conflicts, leftover stashes, and code_sync's stash guard refusing to run
# (found 2026-10-01: 7 stashes, all pure graphify-out noise).
graphify-out/
# (older, narrower entries below are now redundant but harmless)
# graphify local build cache (regenerate with `graphify update .`)
graphify-out/cache/
graphify-out/.graphify_analysis.json
graphify-out/.graphify_python
graphify-out/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
tmp/

# a symlink named node_modules is a file to git, so the "node_modules/" pattern misses it; one was committed by accident and
# replaced the real directory on pull
dashboard/node_modules

# Claude Code worktrees are per-machine; auto-sync swept three in as gitlinks and broke every Mini push (marvin#430)
.claude/worktrees/

# MARVIN's own per-machine state and caches (dashboard/electron/main/marvin_paths.js): never committed, never in ~/.claude
/var/

# Health's per-machine history: never committed (191 of ~200 auto-sync commits on main were these, 2026-10-17..21).
# Each Mac keeps its own; code_sync.NEVER_COMMIT refuses them even where still tracked (plan health-metrics-redo P0).
/bench/metrics/health-monitor.*

# Runtime logs and session transcripts: never public (2026-10-25, a 2 MB transcript was auto-synced here)
logs/
*.jsonl.transcript

# ADR 0071: this person's private instance (its own repo, private remote). Never part of the public engine.
/instance/
# ADR 0071: the owner's state moved to the private instance. Ignored here so a stale writer on any machine can't
# republish it. (docs/screenshots and docs/evidence stay committable: ticket PRs still put evidence images there.)
/bench/metrics/
/docs/plans/
/config/projects/
/retrospective-log.md
