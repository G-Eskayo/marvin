<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.marvin.daily-digest-fallback</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/gileskayo/.agents/venv/bin/python</string>
        <string>/Users/gileskayo/.agents/skills/improve/scripts/daily_digest.py</string>
    </array>

    <!-- MacBook fallback: run every day at 09:30 if primary (Mini @ 08:30) hasn't produced output.
         Gate logic in daily_digest.py uses brief_fallback.should_run() to prevent running during
         primary window. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/gileskayo/marvin</string>

    <key>StandardOutPath</key>
    <string>/Users/gileskayo/.claude/logs/daily-digest.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/gileskayo/.claude/logs/daily-digest-error.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/gileskayo</string>
        <key>PATH</key>
        <string>/Users/gileskayo/.local/bin:/usr/local/bin:/usr/bin:/bin:/Users/gileskayo/.agents/venv/bin</string>
    </dict>

    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
