<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.marvin.research-colony-fallback</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/gileskayo/.agents/venv/bin/python</string>
        <string>/Users/gileskayo/.agents/skills/research-colony/scripts/run_colony.py</string>
    </array>

    <!-- Fallback builder: runs on MacBook only (laptop) if primary (mini) misses its deadline+grace window.
         Primary runs at 09:00 + 60min grace = 10:00, so fallback starts at 10:05 to avoid overlap. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>5</integer>
    </dict>

    <!-- Pin cwd: research_digest.generate() calls marvin_launcher for agentic inference, which reads repo state. -->
    <key>WorkingDirectory</key>
    <string>/Users/gileskayo/marvin</string>

    <key>StandardOutPath</key>
    <string>/Users/gileskayo/.claude/logs/research-colony-fallback.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/gileskayo/.claude/logs/research-colony-fallback-error.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/gileskayo</string>
        <key>PATH</key>
        <string>/Users/gileskayo/.local/bin:/usr/local/bin:/usr/bin:/bin:/Users/gileskayo/.agents/venv/bin</string>
    </dict>

    <!-- Restart if the job crashes -->
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
