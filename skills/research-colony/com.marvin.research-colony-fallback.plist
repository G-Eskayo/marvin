<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Fallback research colony (ADR 0067): laptop-only, runs 60 minutes after the primary (10:00).
     The script's own brief_fallback.should_run() gate decides whether to build. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.marvin.research-colony-fallback</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/gileskayo/.agents/venv/bin/python</string>
        <string>/Users/gileskayo/.agents/skills/research-colony/scripts/run_colony.py</string>
    </array>

    <!-- Run every day at 10:00 (primary 09:00 + 60m grace) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/gileskayo/.claude/logs/research-colony.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/gileskayo/.claude/logs/research-colony-error.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/gileskayo</string>
        <key>PATH</key>
        <string>/Users/gileskayo/.local/bin:/usr/local/bin:/usr/bin:/bin:/Users/gileskayo/.agents/venv/bin</string>
    </dict>

    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
