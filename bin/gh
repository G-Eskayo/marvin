#!/usr/bin/python3 -IS
"""gh — the GitHub gate: every `gh` call on this Mac passes through here before reaching the real gh.

Both Macs, the pipeline, its agents, the dashboard and every job share ONE GitHub account allowance, and ~30 places
call gh on their own. Nothing coordinated them, so a burst tripped GitHub's short-window limit and every caller failed
at once, then kept retrying into it. This gate (stdlib only, so it starts fast):

  cooldown   when GitHub refuses a call for rate reasons, every caller on this Mac pauses together: a burst refusal
             60 s, doubling per repeat up to 15 min; an hourly-allowance refusal until GitHub's reset time
  priority   launchd jobs (com.marvin.*) are background, except the webhook that serves dashboard clicks; people and
             the dashboard are interactive. MARVIN_GH_PRIORITY overrides.
  budget     below 20% of the hourly allowance, background calls wait, so the last of it is kept for people
  spacing    at most 2 background calls at once, and not closer than 0.25 s apart (bursts are what trip the limit)
  log        ~/.claude/logs/gh-calls.jsonl: who called what, how long, whether it was refused (Health reads it)

A deferred background call exits 75 (EX_TEMPFAIL) with a message containing "rate limit", which existing callers
already treat as "try again next cycle". A person at a terminal is never captured: prompts work as usual.
Installed by scripts/install-gh-gate.sh (puts ~/.agents/bin first on PATH). Remove that to bypass it.
"""
from __future__ import annotations
import calendar
import fcntl
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

DEFERRED_RC = 75
BURST_COOLDOWN = 60
MAX_COOLDOWN = 900
INTERACTIVE_MAX_WAIT = 20
BUDGET_FLOOR = 0.20
BUDGET_TTL = 120   # the GraphQL budget query itself costs a point
BG_SLOTS = 2
BG_GAP = 0.25
LOG_MAX_BYTES = 5 * 1024 * 1024
FALLBACKS = ("/opt/homebrew/bin/gh", "/usr/local/bin/gh")


# ── pure decisions ──────────────────────────────────────────────────────────

def classify_refusal(stderr: str) -> str | None:
    s = (stderr or "").lower()
    if "secondary rate limit" in s or "abuse detection" in s or "429" in s and "too many" in s:
        return "burst"
    if "api rate limit" in s and ("exceeded" in s):
        return "hourly"
    return None


def priority_of(env) -> str:
    own = env.get("MARVIN_GH_PRIORITY")
    if own in ("background", "interactive"):
        return own
    svc = env.get("XPC_SERVICE_NAME", "")
    if svc.startswith("com.marvin.") and svc != "com.marvin.dashboard-webhook":
        return "background"
    return "interactive"


def decide(priority: str, state: dict, budget: dict | None, now: float) -> tuple[str, float]:
    """("go", 0) | ("wait", seconds) | ("defer", seconds) | ("refuse", seconds)."""
    left = (state.get("cooldown_until") or 0) - now
    if left > 0:
        if priority == "background":
            return ("defer", left)
        return ("wait", left) if left <= INTERACTIVE_MAX_WAIT else ("refuse", left)
    if priority == "background" and budget and min(budget.get("core", 1), budget.get("graphql", 1)) < BUDGET_FLOOR:
        return ("defer", 0)
    return ("go", 0)


def after_refusal(state: dict, kind: str, now: float, reset_at: float | None) -> dict:
    strikes = int(state.get("strikes") or 0) + 1
    if kind == "hourly" and reset_at:
        until = reset_at
    else:
        until = now + min(BURST_COOLDOWN * 2 ** (strikes - 1), MAX_COOLDOWN)
    return {**state, "strikes": strikes, "cooldown_until": until, "reason": kind}


def after_success(state: dict) -> dict:
    return {**state, "strikes": 0} if state.get("strikes") else state


# ── plumbing ────────────────────────────────────────────────────────────────

# Every copy of the gate starts with this docstring (a worktree's bin/gh, a sandbox HOME's ~/.agents/bin/gh, an older
# install). 2026-10-21: two copies on PATH each took the other for the real gh and called each other back and forth,
# 18,040 logged "pr list" calls in two hours from a caller named "Python". A copy of the gate is never the real gh.
GATE_MARKER = "gh \u2014 the GitHub gate".encode("utf-8")
# Set on the real gh's environment: a gate started from inside a gate (a gh extension calling gh, a copy that missed
# the marker check) passes the call straight through, unlogged, instead of counting and gating it twice.
INSIDE_ENV = "MARVIN_GH_GATE_INSIDE"


def _is_gate(path: str) -> bool:
    try:
        with open(path, "rb") as f:
            return GATE_MARKER in f.read(512)
    except OSError:
        return False


def find_real_gh(path: str) -> str | None:
    me = os.path.realpath(__file__)
    ok = lambda c: os.path.isfile(c) and os.access(c, os.X_OK) and os.path.realpath(c) != me and not _is_gate(c)
    for d in path.split(":"):
        c = os.path.join(d, "gh")
        if d and ok(c):
            return c
    return next((c for c in FALLBACKS if ok(c)), None)


def _logs() -> Path:
    d = Path(os.environ.get("HOME", str(Path.home()))) / ".claude" / "logs"
    d.mkdir(parents=True, exist_ok=True)
    return d


class _State:
    """Read-modify-write of gh-gate.json under a lock, shared by every caller on this Mac."""

    def __init__(self):
        self.path = _logs() / "gh-gate.json"
        self.lock = open(_logs() / "gh-gate.lock", "a+")

    def __enter__(self) -> dict:
        fcntl.flock(self.lock, fcntl.LOCK_EX)
        try:
            self.data = json.loads(self.path.read_text())
        except (OSError, ValueError):
            self.data = {}
        return self.data

    def __exit__(self, *exc):
        try:
            tmp = self.path.with_suffix(".tmp")
            tmp.write_text(json.dumps(self.data))
            tmp.replace(self.path)
        finally:
            fcntl.flock(self.lock, fcntl.LOCK_UN)
        return False


def _rate_limit(real: str) -> dict | None:
    """GitHub's own numbers. GraphQL (what gh issue/pr use) is read from GraphQL itself: on 2026-10-08 the REST
    /rate_limit endpoint said 4,853 GraphQL points were left while GraphQL refused every call at 0."""
    try:
        q = subprocess.run([real, "api", "graphql", "-f", "query={rateLimit{limit remaining resetAt}}"],
                           capture_output=True, text=True, timeout=10)
        g = json.loads(q.stdout)["data"]["rateLimit"]
        r = subprocess.run([real, "api", "rate_limit"], capture_output=True, text=True, timeout=10)
        core = json.loads(r.stdout)["resources"]["core"]
    except Exception:  # noqa: BLE001
        return None
    g_reset = calendar.timegm(time.strptime(g["resetAt"], "%Y-%m-%dT%H:%M:%SZ"))
    resets = [x for x, left in ((core["reset"], core["remaining"]), (g_reset, g["remaining"])) if left == 0]
    return {"core": core["remaining"] / max(core["limit"], 1), "graphql": g["remaining"] / max(g["limit"], 1),
            # when an allowance is really used up, the time it comes back; None = it is not (a burst refusal)
            "reset": min(resets) if resets else None}


def _budget(real: str, now: float) -> dict | None:
    if os.environ.get("GH_GATE_NO_BUDGET"):
        return None
    with _State() as st:
        b = st.get("budget")
        if b and now - b.get("at", 0) < BUDGET_TTL:
            return b
    fresh = _rate_limit(real)
    if fresh:
        fresh["at"] = now
        with _State() as st:
            st["budget"] = fresh
        _append("gh-budget.jsonl", fresh)  # the Metrics tab charts the allowance over time (lib/github_usage.py)
    return fresh


def _background_slot():
    """Hold one of BG_SLOTS lock files; returns the open file (released on exit) or None after a minute."""
    deadline = time.time() + 60
    while time.time() < deadline:
        for i in range(BG_SLOTS):
            f = open(_logs() / f"gh-gate.slot{i}", "a+")
            try:
                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
                with _State() as st:
                    gap = BG_GAP - (time.time() - st.get("last_bg", 0))
                    st["last_bg"] = time.time() + max(gap, 0)
                if gap > 0:
                    time.sleep(gap)
                return f
            except BlockingIOError:
                f.close()
        time.sleep(0.2)
    return None


def _append(name: str, row: dict) -> None:
    try:
        p = _logs() / name
        if p.exists() and p.stat().st_size > LOG_MAX_BYTES:
            lines = p.read_text().splitlines()
            p.write_text("\n".join(lines[len(lines) // 2:]) + "\n")
        with open(p, "a") as f:
            f.write(json.dumps(row) + "\n")
    except OSError:
        pass


def _log(row: dict) -> None:
    try:
        p = _logs() / "gh-calls.jsonl"
        if p.exists() and p.stat().st_size > LOG_MAX_BYTES:
            lines = p.read_text().splitlines()
            p.write_text("\n".join(lines[len(lines) // 2:]) + "\n")
        with open(p, "a") as f:
            f.write(json.dumps(row) + "\n")
    except OSError:
        pass


def _caller() -> str:
    """The launchd job, or else the program that ran gh (python3, node, MARVIN Metrics, zsh...)."""
    job = os.environ.get("MARVIN_JOB") or os.environ.get("XPC_SERVICE_NAME", "")
    if job and job != "0":
        return job
    try:
        out = subprocess.run(["/bin/ps", "-o", "command=", "-p", str(os.getppid())], capture_output=True, text=True, timeout=2).stdout
        words = out.split()
        # name the script, not the interpreter: "Python" alone said nothing about which job made 85 pr list calls
        script = next((w for w in words[1:] if w.endswith((".py", ".js", ".sh", ".mjs"))), None)
        name = os.path.basename(script or (words[0] if words else "")) or "unknown"
        if not script:
            mod = next((words[i + 1] for i, w in enumerate(words[:-1]) if w == "-m"), None)
            name = f"{name} -m {mod}" if mod else name
        return name
    except Exception:  # noqa: BLE001
        return "unknown"


def _say(msg: str) -> None:
    sys.stderr.write(f"gh-gate: {msg}\n")


# ── UI PRs carry current, working images (marvin #735) ─────────────────────
# A PR opened, readied or merged from a chat came straight through here with nothing checking the owner's rule that a
# look change shows images (the dashboard's Approve checks, chats never press it). The rules live in lib/pr_images.py.
# Fails OPEN when GitHub can't be asked (with a note): a gate bug must not stop all PR work, and the dashboard's
# Approve still fails closed. MARVIN_UI_EVIDENCE_OK="<reason>" lets one call through, logged.

UI_EVIDENCE_OK = "MARVIN_UI_EVIDENCE_OK"


def _gh_json(real: str, args: list[str]):
    env = {**os.environ, INSIDE_ENV: "1"}
    p = subprocess.run([real, *args], capture_output=True, text=True, env=env, timeout=60)
    if p.returncode != 0:
        raise RuntimeError((p.stderr or p.stdout).strip().splitlines()[-1:] or ["gh failed"])
    return json.loads(p.stdout)


def ui_evidence_refusal(argv: list[str], ask, read_file=None, current_branch=None, profiles_dir=None) -> str | None:
    """The refusal message for a PR call that breaks the images rule, else None. `ask(args)` runs gh and returns JSON."""
    sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
    import pr_images as pi
    call = pi.parse_pr_call(argv)
    if not call:
        return None
    repo = call["repo"] or ask(["repo", "view", "--json", "nameWithOwner"])["nameWithOwner"]
    if call["action"] == "create":
        if call["body_file"] == "-":
            return None  # the body is on stdin, which belongs to gh
        if call["body_file"]:
            body = (read_file or (lambda f: Path(f).read_text()))(call["body_file"])
        else:
            body = call["body"] or ""
        head = call["head"] or (current_branch or _current_branch)()
        base = call["base"] or ask(["api", f"repos/{repo}"])["default_branch"]
        files = [f["filename"] for f in ask(["api", f"repos/{repo}/compare/{base}...{head}"]).get("files", [])]
        head_ref = head
    else:
        target = [call["target"]] if call["target"] else []
        pr = ask(["pr", "view", *target, "--repo", repo, "--json", "files,body,headRefOid"])
        files, body, head_ref = [f["path"] for f in pr.get("files", [])], pr.get("body") or "", pr.get("headRefOid")

    def changed_since(sha):
        try:
            return [f["filename"] for f in ask(["api", f"repos/{repo}/compare/{sha}...{head_ref}"]).get("files", [])]
        except Exception:  # noqa: BLE001
            return None

    extra = pi.ui_paths_for(repo, profiles_dir or Path(os.environ.get("MARVIN_INSTANCE_DIR") or Path.home() / ".agents" / "instance") / "config" / "projects")
    problems = pi.verdict(files, body, extra, changed_since if head_ref else None)
    if not problems:
        return None
    code, message = problems[0]
    return f"{code}: {message}"


# ── marvin#954: a pull-only node holds no GitHub credential (ADR 0069) ─────────────────────────────────────────────

def pull_only_node(env, platform: str, hostname: str, registry: dict) -> bool:
    """lib/machine_profile.py pull_only(), stdlib-only: a registered device that doesn't accept untagged ("general") work
    is pull-only; an unregistered machine is pull-only unless it is a Mac. Matched by Tailscale hostname here (the gate
    can't read the root-only DMI UUID). MARVIN_PULL_ONLY=1/0 overrides."""
    own = env.get("MARVIN_PULL_ONLY")
    if own in ("0", "1"):
        return own == "1"
    if platform == "darwin":
        return False
    devices = registry.get("devices") if isinstance(registry, dict) else None
    me = next((d for d in devices.values() if isinstance(d, dict) and d.get("tailscale_hostname") == hostname), None) \
        if isinstance(devices, dict) else None
    if me is None:
        return True
    accepts = me.get("accepts", ["general"])
    return not isinstance(accepts, list) or "general" not in accepts


def pull_only_refusal(argv, env, pull_only: bool, at_terminal: bool):
    """Why this call must not reach gh, or None. Only without a token handed in for the run (vm_run's per-run push
    credential) and never for a person at the box's own terminal. Worded so nothing maps it to "sign-in expired"."""
    if not pull_only or at_terminal or env.get("GH_TOKEN") or env.get("GITHUB_TOKEN"):
        return None
    what = " ".join(a for a in argv[:2] if not a.startswith("-"))
    return (f"this machine reads GitHub only through the Mini (ADR 0069); gh {what} was not sent. "
            "Open PRs and boards come from the Mini's feed (marvin#954).")


def _pull_only_here() -> bool:
    import socket
    try:
        registry = json.loads((Path.home() / ".claude" / "marvin-network.json").read_text())
    except (OSError, ValueError):
        registry = {}
    return pull_only_node(os.environ, sys.platform, socket.gethostname().split(".")[0], registry)


def _current_branch() -> str:
    return subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"], capture_output=True, text=True).stdout.strip()


def main(argv: list[str]) -> int:
    real = find_real_gh(os.environ.get("PATH", ""))
    if not real:
        _say("the real gh is not installed")
        return 127
    if os.environ.get(INSIDE_ENV):
        return subprocess.call([real, *argv])
    refusal = pull_only_refusal(argv, os.environ, _pull_only_here(), sys.stdin.isatty() and sys.stderr.isatty())
    if refusal:
        _say(refusal)
        _log({"t": time.time(), "caller": _caller(), "cmd": " ".join(a for a in argv[:2] if not a.startswith("-")), "rc": 1, "pull_only": True})
        return 1
    # Rule I2 (marvin#742): a question to the owner must be in the Decisions format. The rule is lib/decisions_check.py
    # (fails open, like the images rule; a copy of this file with no lib/ beside it skips the rule).
    sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
    try:
        import decisions_check
        if decisions_check.gate(argv, _say, lambda e: _log({"t": time.time(), "caller": _caller(), **e})):
            return 1
    except ImportError:
        pass
    if len(argv) >= 2 and argv[0] == "pr" and argv[1] in ("create", "ready", "merge"):
        override = os.environ.get(UI_EVIDENCE_OK, "").strip()
        try:
            refusal = None if override else ui_evidence_refusal(argv, lambda a: _gh_json(real, a))
        except Exception as e:  # noqa: BLE001
            _say(f"couldn't check this PR's images ({str(e)[:160]}); letting it through")
            refusal = None
        if override:
            _log({"t": time.time(), "caller": _caller(), "cmd": f"pr {argv[1]}", "ui_evidence_override": override[:200]})
        if refusal:
            _say(refusal)
            _say(f"(only if a person agrees the images aren't needed: {UI_EVIDENCE_OK}=\"<reason>\" gh ...)")
            _log({"t": time.time(), "caller": _caller(), "cmd": f"pr {argv[1]}", "rc": 1, "ui_evidence": refusal[:200]})
            return 1
    prio = priority_of(os.environ)
    caller = _caller()
    cmd = " ".join(a for a in argv[:2] if not a.startswith("-"))
    now = time.time()
    with _State() as st:
        state = dict(st)
    verdict, secs = decide(prio, state, _budget(real, now) if prio == "background" else None, now)
    if verdict in ("defer", "refuse"):
        why = (f"cooldown until {time.strftime('%H:%M', time.localtime(state['cooldown_until']))} ({state.get('reason')})"
               if secs else "the hourly allowance is below 20%, kept for people")
        _say(f"API rate limit: {prio} call deferred, {why}")
        _log({"t": now, "caller": caller, "priority": prio, "cmd": cmd, "rc": DEFERRED_RC, "ms": 0, "deferred": verdict})
        return DEFERRED_RC
    if verdict == "wait":
        _say(f"GitHub asked us to slow down; waiting {secs:.0f}s")
        time.sleep(secs)

    slot = _background_slot() if prio == "background" else None
    os.environ[INSIDE_ENV] = "1"  # inherited by the real gh and anything it runs
    t0 = time.time()
    try:
        if sys.stdin.isatty() and sys.stderr.isatty():
            # a person at a terminal: no capturing, prompts and colours work as usual
            rc = subprocess.call([real, *argv])
            err = ""
        else:
            p = subprocess.Popen([real, *argv], stderr=subprocess.PIPE)
            _, raw = p.communicate()
            rc = p.returncode
            err = raw.decode("utf-8", "replace")
            sys.stderr.write(err)
    finally:
        if slot:
            slot.close()
    ms = int((time.time() - t0) * 1000)
    kind = classify_refusal(err) if rc else None
    with _State() as st:
        if kind:
            reset = None
            if kind == "hourly":
                # GitHub says "API rate limit exceeded" for short bursts too (2026-10-08: refused with 4,860 of 5,000
                # left). Only a really empty allowance waits for the hourly reset; anything else is a burst.
                reset = (_rate_limit(real) or {}).get("reset")
                if not reset:
                    kind = "burst"
            st.update(after_refusal(st, kind, time.time(), reset))
        elif rc == 0:
            st.update(after_success(st))
    where = {"cwd": os.getcwd().replace(os.environ.get("HOME", "~"), "~")[-80:]}
    if os.environ.get("PYTEST_CURRENT_TEST"):  # a test reaching real GitHub is a bug: say which one
        where["test"] = os.environ["PYTEST_CURRENT_TEST"][:160]
    _log({"t": now, "caller": caller, "priority": prio, "cmd": cmd, "rc": rc, "ms": ms, **where, **({"refused": kind, "said": err.strip()[-200:]} if kind else {})})
    return rc


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
