[Unit]
Description=MARVIN peer care: one blocked reader on tailscaled's IPN bus; the 2012 watches the Mac mini (marvin#847, ADR 0081)
After=network-online.target tailscaled.service

[Service]
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
ExecStart=%h/.agents/venv/bin/python %h/.agents/lib/peer_care.py watch-ipn
Restart=always
RestartSec=60
StandardOutput=append:%h/.claude/logs/peer-care-ipn.out
StandardError=append:%h/.claude/logs/peer-care-ipn.out

[Install]
WantedBy=default.target
