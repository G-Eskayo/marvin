<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily digest fallback builder (skills/improve/scripts/daily_digest.py, ADR 0067). Falls back only if the
     primary builder (mac-mini) fails to produce the digest by this time. One hour after the primary's scheduled run
     (08:30 primary → 09:30 fallback), so the primary has time to catch any transient failures.
     MacBook only: install on the MacBook via:
       cp this to ~/Library/LaunchAgents/ and `launchctl bootstrap gui/$(id -u) <that file>`
     Do NOT install on the Mac Mini where the primary builder runs.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.marvin.daily-digest-fallback</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/gileskayo/.agents/venv/bin/python</string>
        <string>/Users/gileskayo/.agents/skills/improve/scripts/daily_digest.py</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/gileskayo/.claude/logs/daily-digest-fallback.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/gileskayo/.claude/logs/daily-digest-fallback-error.log</string>
</dict>
</plist>
