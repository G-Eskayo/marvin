<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Quality trends collector (lib/quality_trends.py, marvin#342): daily snapshot of mutation scores,
     test skips, and repo growth. Mini only (ADR 0032 primary-automation-host). Runs daily at 06:00,
     persists via metrics_registry for cross-machine merging and Health check visibility.
     Install: cp this to ~/Library/LaunchAgents/ and `launchctl bootstrap gui/$(id -u) <that file>`. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.marvin.quality-trends</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/gileskayo/.agents/venv/bin/python</string>
        <string>/Users/gileskayo/.agents/lib/quality_trends.py</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/gileskayo/.claude/logs/quality-trends.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/gileskayo/.claude/logs/quality-trends-error.log</string>
</dict>
</plist>
