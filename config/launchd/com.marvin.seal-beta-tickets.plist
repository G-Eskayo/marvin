<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Seal Speak beta alert filing (lib/seal_beta_tickets.py, marvin#409; ADR 0024 thresholds).
     Reads the summary from seal_beta_ingest.py, detects metric breaches (high lag, poor rating, stuck endings),
     and files or updates tickets on clarity-captions. Runs independently every 10 minutes on whatever summary.json
     currently exists (dedup is GitHub-search-based, not timing-based). Mac Mini only.
     Install: cp this to ~/Library/LaunchAgents/ and `launchctl bootstrap gui/$(id -u) <that file>`. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.marvin.seal-beta-tickets</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/gileskayo/.agents/venv/bin/python</string>
        <string>/Users/gileskayo/.agents/lib/seal_beta_tickets.py</string>
        <string>run</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/gileskayo</string>
        <key>PATH</key>
        <string>/Users/gileskayo/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/gileskayo/.agents/venv/bin</string>
    </dict>
    <key>StartInterval</key>
    <integer>600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/gileskayo/.claude/logs/seal-beta-tickets.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/gileskayo/.claude/logs/seal-beta-tickets-error.log</string>
</dict>
</plist>
