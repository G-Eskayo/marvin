<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Seal Speak beta ticket filer (lib/seal_beta_tickets.py, marvin#409; clarity-captions ADR 0024).
     Files or updates GitHub tickets on G-Eskayo/clarity-captions when device-level thresholds are crossed
     (lag_p95 > 2s, stuck endings, median_rating ≤ 4). Reads ~/.claude/seal-beta/summary.json (produced
     by seal_beta_ingest.py) every 10 minutes. Privacy rule: ticket text holds only measurements, never notes.
     Mac Mini only. Install: cp this to ~/Library/LaunchAgents/ and `launchctl bootstrap gui/$(id -u) <that file>`. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.marvin.seal-beta-tickets</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/gileskayo/.agents/venv/bin/python</string>
        <string>/Users/gileskayo/.agents/lib/seal_beta_tickets.py</string>
        <string>run</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/gileskayo</string>
        <key>PATH</key>
        <string>/Users/gileskayo/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/gileskayo/.agents/venv/bin</string>
    </dict>
    <key>StartInterval</key>
    <integer>600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/gileskayo/.claude/logs/seal-beta-tickets.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/gileskayo/.claude/logs/seal-beta-tickets-error.log</string>
</dict>
</plist>
