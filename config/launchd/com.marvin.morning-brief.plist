<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The morning brief (lib/morning_brief.py, marvin#306, ADR 0067): Mini-only with laptop fallback.
     Built at 09:45 on the Mini; if the Mini misses its deadline, the laptop's
     morning-brief-fallback runs at 10:45 (gated by brief_fallback.should_run()).
     Install: cp this to ~/Library/LaunchAgents/ and `launchctl bootstrap gui/$(id -u) <that file>`. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.marvin.morning-brief</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/gileskayo/.agents/venv/bin/python</string>
        <string>/Users/gileskayo/.agents/lib/morning_brief.py</string>
        <string>build</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>45</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/gileskayo/.claude/logs/morning-brief.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/gileskayo/.claude/logs/morning-brief-error.log</string>
</dict>
</plist>
