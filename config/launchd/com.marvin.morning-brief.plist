<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The morning brief (lib/morning_brief.py, marvin#306), primary builder on Mini only, runs at 09:45.
     Scheduled after the daily digest (08:30 mini), the research digest (09:00 mini), and their cross-machine merge (09:30).
     Fallback builder on MacBook runs ~5 min after primary deadline+grace window (primary 09:45 + 60min = 10:45, fallback 10:50).
     Install: cp this to ~/Library/LaunchAgents/ and `launchctl bootstrap gui/$(id -u) <that file>` on mini. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.marvin.morning-brief</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/gileskayo/.agents/venv/bin/python</string>
        <string>/Users/gileskayo/.agents/lib/morning_brief.py</string>
        <string>build</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>45</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/gileskayo/.claude/logs/morning-brief.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/gileskayo/.claude/logs/morning-brief-error.log</string>
</dict>
</plist>
