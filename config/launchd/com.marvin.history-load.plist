<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- History store loader (lib/history_store.py, ADR 0066, marvin#449): every 5 minutes, moves new lines from both
     Macs' outboxes (~/.claude/logs/*.jsonl) into ~/.agents/var/history.db. Reads only new bytes; an unreachable laptop
     is skipped and caught up later. Mac mini only (the database's home).
     Install: cp this to ~/Library/LaunchAgents/ and `launchctl bootstrap gui/$(id -u) <that file>`. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.marvin.history-load</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/gileskayo/.agents/venv/bin/python</string>
        <string>/Users/gileskayo/.agents/lib/history_store.py</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/gileskayo</string>
        <key>PATH</key>
        <string>/Users/gileskayo/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/gileskayo/.agents/venv/bin</string>
    </dict>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>StandardOutPath</key>
    <string>/Users/gileskayo/.claude/logs/history-load.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/gileskayo/.claude/logs/history-load-error.log</string>
</dict>
</plist>
