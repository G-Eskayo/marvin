<?xml version="1.0" encoding="UTF-8"?>
<!-- "I'm back" (lib/peer_care.py im-back, marvin#847, ADR 0081): once at login after a restart, this Mac asks each of
     its watchers to probe it, which closes any open incident. After an authrestart FileVault logs the owner in, so
     a LaunchAgent with RunAtLoad runs at the right moment. Same file on every Mac that has watchers.
     Install: cp this to ~/Library/LaunchAgents/ and `launchctl bootstrap gui/$(id -u) <that file>`. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.marvin.peer-care-im-back</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/gileskayo/.agents/venv/bin/python</string>
        <string>/Users/gileskayo/.agents/lib/peer_care.py</string>
        <string>im-back</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/gileskayo</string>
        <key>PATH</key>
        <string>/Users/gileskayo/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/gileskayo/.agents/venv/bin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/gileskayo/.claude/logs/peer-care-im-back.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/gileskayo/.claude/logs/peer-care-im-back-error.log</string>
</dict>
</plist>
