<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The guarded nightly reset (lib/nightly_reset.py, marvin#847, ADR 0081). One event a night per slot, never a poll:
     it fires at every Mac's slot (config/peer_care.json reset.slots) and each Mac acts only at its own, so the same
     file goes on the Mac mini and the MacBook. Without the owner's one-time `sudo ~/.agents/bin/marvin-reset-setup`
     it records why and skips; it never does a plain restart. Steps go to job_events as `nightly-reset`.
     Install on each Mac: cp this to ~/Library/LaunchAgents/ and `launchctl bootstrap gui/$(id -u) <that file>`. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.marvin.nightly-reset</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/gileskayo/.agents/venv/bin/python</string>
        <string>/Users/gileskayo/.agents/lib/nightly_reset.py</string>
        <string>run</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/gileskayo</string>
        <key>PATH</key>
        <string>/Users/gileskayo/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/gileskayo/.agents/venv/bin</string>
    </dict>
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>0</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>2</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
    </array>
    <key>StandardOutPath</key>
    <string>/Users/gileskayo/.claude/logs/nightly-reset.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/gileskayo/.claude/logs/nightly-reset-error.log</string>
</dict>
</plist>
