<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The morning brief fallback (lib/morning_brief.py, marvin#306, ADR 0066). Runs 1h after the primary (10:45)
     on the laptop; skips silently if the primary (Mini, 09:45) already produced it. Gates on brief_fallback.should_run()
     to avoid duplicate work when both machines are online.
     Install: cp this to ~/Library/LaunchAgents/ and `launchctl bootstrap gui/$(id -u) <that file>`. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.marvin.morning-brief-fallback</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/gileskayo/.agents/venv/bin/python</string>
        <string>/Users/gileskayo/.agents/lib/morning_brief.py</string>
        <string>build</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>45</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/gileskayo/.claude/logs/morning-brief.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/gileskayo/.claude/logs/morning-brief-error.log</string>
</dict>
</plist>
