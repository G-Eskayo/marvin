<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Morning brief fallback builder (lib/morning_brief.py, ADR 0067). Falls back only if the primary builder
     (mac-mini) fails to produce the brief by this time. One hour after the primary's scheduled run
     (09:45 primary → 10:45 fallback), so the primary has time to catch any transient failures.
     MacBook only: install on the MacBook via:
       cp this to ~/Library/LaunchAgents/ and `launchctl bootstrap gui/$(id -u) <that file>`
     Do NOT install on the Mac Mini where the primary builder runs.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.marvin.morning-brief-fallback</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/gileskayo/.agents/venv/bin/python</string>
        <string>/Users/gileskayo/.agents/lib/morning_brief.py</string>
        <string>build</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>45</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/gileskayo/.claude/logs/morning-brief-fallback.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/gileskayo/.claude/logs/morning-brief-fallback-error.log</string>
</dict>
</plist>
