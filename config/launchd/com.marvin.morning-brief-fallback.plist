<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Morning brief fallback (lib/morning_brief.py, marvin#458 AC1): runs on the MacBook if the Mini hasn't
     produced a brief by 10:45. Scheduled one hour after the primary's usual 09:45 time.
     Install: cp this to ~/Library/LaunchAgents/ and `launchctl bootstrap gui/$(id -u) <that file>`. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.marvin.morning-brief-fallback</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>~/.agents/venv/bin/python ~/.agents/lib/morning_brief.py build >> ~/.claude/logs/morning-brief.log 2>> ~/.claude/logs/morning-brief-error.log</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>45</integer>
    </dict>
</dict>
</plist>
