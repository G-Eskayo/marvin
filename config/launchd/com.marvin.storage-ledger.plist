<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily disk usage ledger and auto-trim (lib/storage_ledger.py): tracks disk usage trends and auto-trims
     caches/build output when free space falls below the yellow threshold. Log: ~/.claude/logs/storage-trim.md.
     Install on each machine: cp this to ~/Library/LaunchAgents/ and `launchctl bootstrap gui/$(id -u) <that file>`. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.marvin.storage-ledger</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/gileskayo/.agents/venv/bin/python</string>
        <string>/Users/gileskayo/.agents/lib/storage_ledger.py</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/gileskayo</string>
        <key>PATH</key>
        <string>/Users/gileskayo/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/gileskayo/.agents/venv/bin</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/gileskayo/.claude/logs/storage-ledger.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/gileskayo/.claude/logs/storage-ledger-error.log</string>
</dict>
</plist>
