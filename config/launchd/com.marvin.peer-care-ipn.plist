<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Peer care's one blocked reader on tailscaled's IPN bus (lib/peer_care.py watch-ipn, marvin#847, ADR 0081). It
     wakes only when the tailnet changes; a watched peer going offline (or coming back with an incident open) is
     handled once. For the watchers only: the Mac mini (the 2012 runs config/mac-mini-2012/marvin-peer-care-ipn.service).
     Install: cp this to ~/Library/LaunchAgents/ and `launchctl bootstrap gui/$(id -u) <that file>`. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.marvin.peer-care-ipn</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/gileskayo/.agents/venv/bin/python</string>
        <string>/Users/gileskayo/.agents/lib/peer_care.py</string>
        <string>watch-ipn</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/gileskayo</string>
        <key>PATH</key>
        <string>/Users/gileskayo/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/gileskayo/.agents/venv/bin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- if tailscaled is down the reader exits at once: don't respawn faster than once a minute -->
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>/Users/gileskayo/.claude/logs/peer-care-ipn.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/gileskayo/.claude/logs/peer-care-ipn-error.log</string>
</dict>
</plist>
